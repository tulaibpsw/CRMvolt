{
  "name": "volton-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run ai:check",
    "ai:sync": "node scripts/sync-ai.mjs",
    "ai:check": "node scripts/check-ai.mjs",
    "seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed.ts",
    "db:indexes": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/sync-indexes.ts",
    "ui:shots": "node scripts/screenshot-catalog.mjs",
    "create-super-admin": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/create-super-admin.ts",
    "clear-demo-data": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/clear-demo-data.ts"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.11",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^1.52.0",
    "mongoose": "^9.10.4",
    "next": "16.3.8",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "culori": "^4.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.2",
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
